{
  "name": "garage",
  "private": true,
  "version": "1.2.15",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:shared": "npm run build -w packages/shared",
    "build": "npm run build:shared && npm run build -w apps/api && npm run build -w apps/web",
    "prisma:generate": "npm run prisma:generate -w apps/api",
    "prisma:migrate": "npm run prisma:migrate -w apps/api",
    "test": "npm run build:shared && npm run test -w apps/api && npm run test -w apps/web"
  },
  "allowScripts": {
    "@prisma/client@7.9.0": true,
    "@prisma/engines@7.9.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.9.0": true
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "find-my-way": "^9.7.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
